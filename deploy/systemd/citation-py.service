# Example unit for the Python citation service (see ../../services/citation-py).
# Committed as documentation; not run in this repository's CI.
#   install: cp citation-py.service /etc/systemd/system/ && systemctl enable --now citation-py

[Unit]
Description=Basic Law citation service (Flask via Gunicorn)
After=network.target

[Service]
Type=notify
User=www-data
WorkingDirectory=/srv/basic-law/services/citation-py
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/basic-law/services/citation-py/.venv/bin/gunicorn \
    --workers 2 --bind 127.0.0.1:8000 --timeout 30 --access-logfile - app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=2

# The service only formats and parses citation strings: no database, no writes, no outbound network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
