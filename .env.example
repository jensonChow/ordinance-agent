# PostgreSQL connection (Prisma). Local: a Homebrew/Docker Postgres; Vercel: Neon / Supabase / Azure Database for PostgreSQL.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/ordinance_agent"

# --- Model provider -------------------------------------------------------
# Preferred: Azure OpenAI (AI SDK @ai-sdk/azure). Set all three.
AZURE_RESOURCE_NAME=""        # e.g. my-resource  -> https://my-resource.openai.azure.com
AZURE_API_KEY=""
AZURE_DEPLOYMENT=""           # the deployment name you created in Azure AI Foundry, e.g. gpt-4.1-mini

# Fallback for local development without Azure: any OpenAI-compatible endpoint (e.g. OpenRouter).
OPENAI_COMPATIBLE_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="anthropic/claude-sonnet-4"

# Force a provider: "azure" | "openai-compatible" | "mock" (scripted model for keyless tests). Default: azure when configured, else openai-compatible.
MODEL_PROVIDER=""

# --- MCP ------------------------------------------------------------------
# Where the chat route finds the Basic Law MCP server. Defaults to the same deployment (/api/mcp).
MCP_SERVER_URL=""

# --- Optional Python citation service (Flask + Gunicorn) ------------------
CITATION_SERVICE_URL=""       # e.g. http://127.0.0.1:8000
